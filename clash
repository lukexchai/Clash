}

# ========== 打开面板 ==========
clash_open() {
    if is_running; then
        open "http://127.0.0.1:${API_PORT}/ui"
        echo ""
        echo "  ${ICON_OK} 已打开管理面板"
        echo "  ${DIM}${CYAN}http://127.0.0.1:${API_PORT}/ui${NC}"
        echo ""
    else
        echo "  ${YELLOW}${ICON_WARN} mihomo 未运行，请先启动${NC}"
    fi
}

