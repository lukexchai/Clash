interactive_menu() {
    while true; do
        show_menu
        read choice
        echo ""
        case "$choice" in
            1) clash_start ;;
            2) clash_stop ;;
            3) clash_restart ;;
            4) clash_reload ;;
            5) clash_status ;;
            6) clash_log ;;
            7) clash_import ;;
            8) clash_open ;;
            9) clash_edit ;;
            l|L) clash_link ;;

            r|R) clash_cleanup ;;
            0|q|Q)
                echo ""
                echo "  ${PURPLE}╭──────────────────────────╮${NC}"
                echo "  ${PURPLE}│${NC}  ${BOLD}期待下次相遇 👋${NC}        ${PURPLE}│${NC}"
                printf "  ${PURPLE}│${NC}  ${DIM}%s${NC}  ${PURPLE}│${NC}\n" "Mihomo $(date +%H:%M)"
                echo "  ${PURPLE}╰──────────────────────────╯${NC}"
                echo ""
                break
                ;;
            *)  echo "  ${YELLOW}${ICON_WARN} 无效选项，请输入 0-9 或 L/R${NC}" ;;
        esac
        echo ""
        echo -n "  按 Enter 返回菜单..."
        read
    done
}

# ========== 入口 ==========
case "${1:-}" in
    start)   clash_start "$2" ;;
    stop)    clash_stop ;;
    restart) clash_restart "$2" ;;
    reload)  clash_reload "$2" ;;
